{
    "manifest_version": 3,
    "name": "Regex Highlight & Search",
    "version": "1.0.0",
    "description": "Highlight and search text on web pages using regex patterns with navigation controls",
    "permissions": [
        "activeTab",
        "storage",
        "contextMenus"
    ],
    "background": {
        "service_worker": "assets/background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "assets/content.js"
            ]
        }
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "options_page": "options.html"
}